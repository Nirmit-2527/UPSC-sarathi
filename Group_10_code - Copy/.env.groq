# =========================================================
# UPSC Sarathi Agentic — GROQ profile (FREE)
#
# How to use:
#   1. Copy this file to .env:   cp .env.groq .env
#   2. Replace the placeholder below with your real key
#   3. That is the ONLY edit required — everything else is ready
#
# Get a FREE Groq API key (no credit card) at:
#   https://console.groq.com  →  "API Keys"  →  "Create API Key"
# =========================================================

APP_MODE=local
APP_ENV=development
LOG_LEVEL=INFO

# ── LLMs: Groq free-tier cloud inference ───────────────
LLM_PROVIDER=groq
GROQ_API_KEY=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
GROQ_BASE_URL=https://api.groq.com/openai/v1

# NOTE: Groq decommissioned llama-3.3-70b-versatile and llama-3.1-8b-instant on
# 2026-08-16 (they now return 404 model_not_found). Use the gpt-oss models.
# Smart/long tier — openai/gpt-oss-120b (free tier: 1 000 req/day, 8K tokens/min)
GROQ_MODEL=openai/gpt-oss-120b
# Fast tier — openai/gpt-oss-20b (free tier: 1 000 req/day, 8K tokens/min)
GROQ_MODEL_FAST=openai/gpt-oss-20b
# gpt-oss are reasoning models; keep effort low so reasoning tokens don't eat max_tokens
GROQ_REASONING_EFFORT=low

# ── Embeddings: local sentence-transformers (CPU, no GPU) ──
# Model (~450 MB) downloads automatically on first ingest.
# No internet needed after that one-time download.
EMBEDDINGS_PROVIDER=sentence_transformers
ST_MODEL_NAME=BAAI/bge-base-en-v1.5

# ── Vector DB: local Chroma ─────────────────────────────
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./data/chroma

# ── PDF processing ──────────────────────────────────────
PDF_LOADER=pdfplumber

# ── Agent settings ──────────────────────────────────────
AGENTS_VERBOSE=false

# IMPORTANT — keep AGENT_MAX_RPM at 25 or lower.
# Groq free tier is capped at 30 RPM total across all models.
# Setting this to 25 leaves a buffer and prevents 429 errors
# during multi-step agent chains (mains write, essay, etc.).
AGENT_MAX_RPM=25

GUARDRAIL_MAX_RETRIES=4
ENABLE_PYQ_MATCHING_IN_QA=true
ENABLE_CURRENT_AFFAIRS_DIGEST=true

# TIP — set this to false while developing/testing to save
# your daily quota on openai/gpt-oss-120b (1 000 req/day).
# The FactChecker adds one extra LLM call per mains-answer attempt.
# Switch back to true for demos and final submission.
ENABLE_GROUNDEDNESS_CHECK=true

# ── UPSC answer standards ───────────────────────────────
MAINS_ANSWER_DEFAULT_MARKS=15
ESSAY_TARGET_WORDS=1500
ESSAY_WORD_TOLERANCE=150

# ── Application ─────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
ALLOWED_ORIGINS=*

# ── AWS / DynamoDB — not needed for the Groq profile ────
AWS_REGION=us-east-1
ENABLE_PROGRESS_TRACKING=false
