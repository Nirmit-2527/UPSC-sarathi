# =========================================================
# UPSC Sarathi Agentic - Environment Configuration
# Copy this to `.env` and fill in your values.
#
# This ONE file (via different values) drives BOTH deployment profiles.
# Two ready-made profiles are below - uncomment the one you want, or see
# SETUP_LOCAL.md / DEPLOY_AWS.md for the full guided walkthrough.
# =========================================================

# --- Deployment mode ---
APP_MODE=local
APP_ENV=development
LOG_LEVEL=INFO

# ---------------------------------------------------------
# PROFILE 1: LOCAL (Ollama + Chroma) - the default below
# ---------------------------------------------------------
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./data/chroma

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b           # "smart" tier
OLLAMA_MODEL_FAST=llama3.2:3b      # "fast" tier (routing, PYQ matching, tagging)

EMBEDDINGS_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---------------------------------------------------------
# PROFILE 2: AWS (Bedrock + OpenSearch Serverless) - comment
# Profile 1 out above and uncomment this block instead, or just override
# these same variable names with AWS values when deploying via
# scripts/deploy_aws.sh (which injects them as ECS task env vars).
# ---------------------------------------------------------
# APP_MODE=aws
# VECTOR_STORE=opensearch
# OPENSEARCH_ENDPOINT=               # filled in automatically by deploy_aws.sh from terraform output
# OPENSEARCH_INDEX=upsc-sarathi-index
#
# LLM_PROVIDER=bedrock
# BEDROCK_LLM_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0   # "smart" tier
# BEDROCK_LLM_MODEL_FAST=anthropic.claude-3-5-haiku-20241022-v1:0  # "fast" tier
#
# EMBEDDINGS_PROVIDER=bedrock
# BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
# EMBEDDINGS_DIM=1024
#
# USE_TEXTRACT=true                  # Textract handles scanned/image PDFs better than pdfplumber

# --- AWS credentials & region (used by BOTH profiles for OpenSearch SigV4
# auth / Bedrock calls; leave keys blank on ECS - the task IAM role is used
# automatically via the default credential chain) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- S3 (document storage on AWS; unused in local profile) ---
S3_BUCKET_NAME=upsc-sarathi-agentic-docs
S3_RAW_PREFIX=raw/
S3_PROCESSED_PREFIX=processed/

# --- OpenAI (optional third provider for either LLM_PROVIDER or
# EMBEDDINGS_PROVIDER, e.g. if you don't want to run Ollama locally and
# don't have AWS Bedrock access) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o            # "smart" tier
OPENAI_MODEL_FAST=gpt-4o-mini  # "fast" tier

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- PDF processing ---
PDF_LOADER=pdfplumber          # pypdf | pdfplumber | unstructured

# --- Agents (CrewAI) ---
AGENTS_VERBOSE=false           # true prints full CrewAI step-by-step reasoning to the console - great for demos
AGENT_MAX_RPM=30
GUARDRAIL_MAX_RETRIES=4
ENABLE_PYQ_MATCHING_IN_QA=true
ENABLE_CURRENT_AFFAIRS_DIGEST=true
ENABLE_GROUNDEDNESS_CHECK=true  # FactChecker agent verifies mains-answer evidence against retrieved context

# --- UPSC answer-writing standards ---
MAINS_ANSWER_DEFAULT_MARKS=15
ESSAY_TARGET_WORDS=1500
ESSAY_WORD_TOLERANCE=150

# --- Application ---
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
ALLOWED_ORIGINS=*

# --- DynamoDB (optional - spaced-revision progress tracking on AWS) ---
ENABLE_PROGRESS_TRACKING=false
DDB_TABLE_PROGRESS=upsc-sarathi-progress
